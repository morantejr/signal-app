# LLM gateway — OpenRouter is the only LLM path.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Pinned from OpenRouter's free list on 2026-09-23 (262k context, JSON mode, tools).
# Swap for any other id; free ids end in ":free".
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Tried in order when the model above is rate-limited upstream (free pool) or returns nothing
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,nex-agi/nex-n2.5-pro:free,google/gemma-4-26b-a4b-it:free
# Optional per-agent overrides (default to OPENROUTER_MODEL)
# MODEL_EVIDENCE=
# MODEL_BULL=
# MODEL_BEAR=
# MODEL_SYNTHESIS=
# MODEL_CRITIC=
# Sent as HTTP-Referer / X-Title so OpenRouter can attribute the app
APP_REFERER=https://morantejr.github.io/signal-app/
APP_TITLE=SIGNAL research

# Langfuse (self-hosted, `make langfuse`). Leave blank to trace to runs/<id>/trace.jsonl only.
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Free data
FRED_API_KEY=
# SEC EDGAR requires an identifying User-Agent: "Name email"
EDGAR_USER_AGENT=SIGNAL research you@example.com

RUNS_DIR=runs
